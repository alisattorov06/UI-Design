{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "primitives": {
      "neutral": {
        "0": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
        "950": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.05, 0, 0] } }
      },
      "brand": {
        "600": { "$type": "color", "$value": { "colorSpace": "oklch", "components": [0.65, 0.14, 260] } }
      }
    },
    "semantic": {
      "bg": {
        "canvas": { "$type": "color", "$value": "{color.primitives.neutral.0}" },
        "surface": { "$type": "color", "$value": "{color.primitives.neutral.0}" },
        "subtle": { "$type": "color", "$value": "{color.primitives.neutral.50}" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "{color.primitives.neutral.950}" },
        "secondary": { "$type": "color", "$value": "{color.primitives.neutral.700}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.primitives.neutral.200}" },
        "interactive": { "$type": "color", "$value": "{color.primitives.brand.600}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{color.primitives.brand.600}" }
      }
    }
  },
  "spacing": {
    "scale": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" }
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "2px" },
    "md": { "$type": "dimension", "$value": "4px" },
    "lg": { "$type": "dimension", "$value": "6px" },
    "xl": { "$type": "dimension", "$value": "8px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "medium": { "$type": "duration", "$value": "240ms" },
      "slow": { "$type": "duration", "$value": "360ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] }
    }
  },
  "decision": {
    "density": {
      "$type": "string",
      "$value": "normal",
      "$description": "compact | normal | comfortable"
    },
    "surface": {
      "style": {
        "$type": "string",
        "$value": "flat",
        "$description": "flat | soft | glass | neo-brutalist | brutalist | swiss"
      }
    },
    "motion": {
      "emphasis": {
        "$type": "string",
        "$value": "subtle",
        "$description": "subtle | normal | expressive | none"
      }
    }
  }
}
